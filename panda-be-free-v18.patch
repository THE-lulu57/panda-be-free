+private enum PrintInfoDiskCache {
+    struct Loaded {
+        let thumbnail: Data?
+        let estimatedSeconds: Int?
+        let weightGrams: Double?
+        let colorHexes: [String]?
+    }
+
+    private struct Entry: Codable {
+        let estimatedSeconds: Int?
+        let weightGrams: Double?
+        let colorHexes: [String]?
